+    def test_side_session_relationship_is_preserved_without_modifying_metadata(self):
+        parent_id = "local_" + str(uuid4())
+        _, path = self.record(spawnedFrom={"sessionId": parent_id, "sideSession": True, "name": "t3-aw"})
+        original = path.read_bytes()
+        session = SessionStore(self.data).list()[0]
+        self.assertEqual(session.parent_session_id, parent_id)
+        self.assertEqual(session.side_session_name, "t3-aw")
+        self.assertEqual(path.read_bytes(), original)
+
+    def test_missing_or_malformed_side_session_metadata_does_not_drop_the_session(self):
+        for spawned in (None, [], "bad", {"sessionId": [], "sideSession": True, "name": {}}, {"sessionId": "parent", "sideSession": False}):
+            with self.subTest(spawned=spawned):
+                self.record(spawnedFrom=spawned)
+                store = SessionStore(self.data)
+                sessions = store.list()
+                self.assertEqual(len(sessions), 1)
+                self.assertIsNone(sessions[0].parent_session_id)
+                self.assertEqual(sessions[0].side_session_name, "")
+                self.assertEqual(store.warnings, [])
